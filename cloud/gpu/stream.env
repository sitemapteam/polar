SELKIES_AUDIO_BITRATE=320000
SELKIES_AUDIO_CHANNELS=2
SELKIES_USE_CSS_SCALING=false
SELKIES_SCALING_DPI=192
SELKIES_ENABLE_RESIZE=true
SELKIES_SECOND_SCREEN=false
SELKIES_MICROPHONE_ENABLED=false
SELKIES_WEBCAM_ENABLED=false
SELKIES_GAMEPAD_ENABLED=false
SELKIES_ENABLE_CLIPBOARD=false
SELKIES_FILE_TRANSFERS=none
SELKIES_PRINTING_ENABLED=false
SELKIES_COMMAND_ENABLED=false
SELKIES_UI_TITLE=Polar
SELKIES_UI_SHOW_LOGO=false
SELKIES_UI_SHOW_SIDEBAR=false
NVIDIA_DRIVER_CAPABILITIES=all
