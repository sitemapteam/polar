SELKIES_ENABLE_HTTPS=false
SELKIES_ENABLE_BASIC_AUTH=true
SELKIES_BASIC_AUTH_USER=polar
SELKIES_MODE=websockets
SELKIES_ENABLE_DUAL_MODE=false
SELKIES_AUTO_GPU=nvidia
SELKIES_ENCODER=h264enc,av1enc,h265enc
SELKIES_FRAMERATE=60
SELKIES_VIDEO_BITRATE=40000
SELKIES_RATE_CONTROL_MODE=cbr,crf
