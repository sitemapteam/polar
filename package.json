{
  "name": "polar-northbound",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic northern steam-train audiobook journey",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build.cjs",
